<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="一、本地“自己人档案”（仅存本机，防自己转自己误记）"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etRealName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="本人真实姓名（仅存本机，识别本人名下互转）"
            android:inputType="textPersonName" />

        <EditText
            android:id="@+id/etAliases"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="常用昵称（多个用逗号分隔）"
            android:inputType="text" />

        <EditText
            android:id="@+id/etCardTails"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="本人银行卡后四位（如 6288,8841）"
            android:inputType="text" />

        <EditText
            android:id="@+id/etBrokers"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="常用券商名（逗号分隔，识别银证转账）"
            android:inputType="text" />

        <!-- Optional cloud AI API UI temporarily hidden while running pure-offline beta; core code kept intact -->
        <LinearLayout
            android:id="@+id/layoutAiApiSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="可选大模型 API（默认纯离线运行，零遥测，不内置作者 Key）"
                android:textStyle="bold" />

            <CheckBox
                android:id="@+id/cbUseRealApi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="启用自有 OpenAI 兼容 API（取消勾选则完全离线零网络请求）" />

            <EditText
                android:id="@+id/etBaseUrl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="HTTPS Base URL（默认 https://api.deepseek.com）"
                android:inputType="textUri" />

            <EditText
                android:id="@+id/etModel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Model 名称（默认 deepseek-chat）"
                android:inputType="text" />

            <EditText
                android:id="@+id/etApiKey"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="自有 API Key（仅存本机，不进入加密备份）"
                android:inputType="textPassword" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="二、加密逻辑快照备份与恢复（AES-256-GCM）"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnExportBackup"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:text="导出加密备份"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnRestoreBackup"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:text="校验并恢复备份"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="三、版本与手动检查更新（仅点击时联网，默认零后台请求）"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvAppVersionInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="当前版本"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnCheckUpdate"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="6dp"
            android:text="手动检查 GitHub 新版本（SHA-256 校验安装）"
            android:textSize="12sp" />

    </LinearLayout>
</ScrollView>
