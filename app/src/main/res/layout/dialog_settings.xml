<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="一、本地“自己人档案”（仅存本机，防自己转自己误记）"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etRealName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="本人真实姓名（发给AI前自动替换成[本人姓名]）"
            android:inputType="textPersonName" />

        <EditText
            android:id="@+id/etAliases"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="常用昵称（多个用逗号分隔）"
            android:inputType="text" />

        <EditText
            android:id="@+id/etCardTails"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="本人银行卡后四位（如 6288,8841）"
            android:inputType="text" />

        <EditText
            android:id="@+id/etBrokers"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="常用券商名（逗号分隔，识别银证转账）"
            android:inputType="text" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="二、大模型 API 配置（默认启用 DeepSeek，可随时更换 Key 或模型）"
            android:textStyle="bold" />

        <CheckBox
            android:id="@+id/cbUseRealApi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="启用真实大模型 API（默认开启 DeepSeek）" />

        <EditText
            android:id="@+id/etBaseUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Base URL（默认 https://api.deepseek.com）"
            android:inputType="textUri" />

        <EditText
            android:id="@+id/etModel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Model 名称（默认 deepseek-chat）"
            android:inputType="text" />

        <EditText
            android:id="@+id/etApiKey"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="API Key（若通过 GitHub Secret 编译已自动注入，可在此覆盖）"
            android:inputType="textPassword" />

    </LinearLayout>
</ScrollView>
